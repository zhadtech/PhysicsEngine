# Environment template — 10-INFRASTRUCTURE §4 (D22: 12-factor, config is env
# vars only, so the same image promotes dev → staging → prod).
#
# NAMES ONLY. Every value here is empty and must stay empty: no secret value
# ever lives in the repo. Real values are injected from the platform's secret
# manager at deploy; rotation is a redeploy.
#
# The secret block below must match `SECRETS` in types/infra.ts exactly —
# tools/verify-workspace.mjs fails the build if a secret is added to one and
# not the other, or if any value here is non-empty.

# --- non-secret config -----------------------------------------------------
# Which ENVIRONMENTS entry (types/infra.ts ENV_IDS) this process is running as.
APP_ENV=
# Web origin for this environment (ENVIRONMENTS[APP_ENV].webOrigin).
WEB_ORIGIN=
# Port the Fastify API binds (apps/api, P4).
PORT=

# --- secrets: server-only, never shipped to the client ---------------------
# D15 — the AI proxy holds provider keys; BYO-key was rejected.
AI_PROVIDER_KEY=
# D12 — DB sessions + PKCE OAuth; signed/exchanged server-side only.
SESSION_SECRET=
OAUTH_GOOGLE_SECRET=
OAUTH_GITHUB_SECRET=
# D22 — datastore + vendor driver credentials (U14 picks are deploy choices).
DATABASE_URL=
REDIS_URL=
OBJECT_STORAGE_KEY=
EMAIL_API_KEY=
