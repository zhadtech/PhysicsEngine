{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://physics-sandbox.dev/schemas/scene.v1.json",
  "title": "Physics Sandbox Scene (schemaVersion 1)",
  "description": "Normative schema for scene documents. Structure, types and ranges only; semantic rules (unique ids, reference resolution, anchor names, size-limit cross-checks) are enforced by the scene-format package. See 02-SCENE-FORMAT.md.",
  "type": "object",
  "required": ["schemaVersion", "engineVersion", "world", "objects"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 1 },
    "engineVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(-[0-9A-Za-z.-]+)?$"
    },
    "meta": { "$ref": "#/$defs/meta" },
    "world": { "$ref": "#/$defs/world" },
    "objects": {
      "type": "array",
      "maxItems": 5000,
      "items": { "$ref": "#/$defs/sceneObject" }
    },
    "links": {
      "type": "array",
      "maxItems": 1000,
      "items": { "$ref": "#/$defs/link" }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,24}$"
    },
    "vec2": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": { "type": "number", "minimum": -1000, "maximum": 1000 }
    },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "title": { "type": "string", "minLength": 1, "maxLength": 80 },
        "description": { "type": "string", "maxLength": 500 },
        "tags": {
          "type": "array",
          "maxItems": 10,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 24 }
        },
        "durationHint": { "type": "number", "minimum": 1, "maximum": 600 }
      }
    },
    "world": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "gravity": { "type": "number", "minimum": 0, "maximum": 100 },
        "planeAngle": { "type": "number", "minimum": -180, "maximum": 180 },
        "seed": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
        "bounds": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": { "type": "number", "minimum": 0.5, "maximum": 200 }
        }
      }
    },
    "objBase": {
      "type": "object",
      "required": ["id", "type", "pos"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "type": { "type": "string" },
        "pos": { "$ref": "#/$defs/vec2" },
        "rot": { "type": "number", "minimum": -36000, "maximum": 36000 },
        "skin": { "type": "string", "minLength": 1, "maxLength": 32 }
      }
    },
    "staticSurfaceProps": {
      "type": "object",
      "properties": {
        "friction": { "type": "number", "minimum": 0, "maximum": 2 },
        "restitution": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "dynProps": {
      "type": "object",
      "properties": {
        "density": { "type": "number", "minimum": 0.1, "maximum": 100 },
        "friction": { "type": "number", "minimum": 0, "maximum": 2 },
        "restitution": { "type": "number", "minimum": 0, "maximum": 1 },
        "magnetic": { "type": "boolean" },
        "anchored": { "type": "boolean" },
        "vel": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": { "type": "number", "minimum": -50, "maximum": 50 }
        },
        "angVel": { "type": "number", "minimum": -3600, "maximum": 3600 }
      }
    },
    "sceneObject": {
      "oneOf": [
        { "$ref": "#/$defs/obj_platform" },
        { "$ref": "#/$defs/obj_ramp" },
        { "$ref": "#/$defs/obj_curve" },
        { "$ref": "#/$defs/obj_domino" },
        { "$ref": "#/$defs/obj_marble" },
        { "$ref": "#/$defs/obj_crate" },
        { "$ref": "#/$defs/obj_plank" },
        { "$ref": "#/$defs/obj_gear" },
        { "$ref": "#/$defs/obj_lever" },
        { "$ref": "#/$defs/obj_spring" },
        { "$ref": "#/$defs/obj_pendulum" },
        { "$ref": "#/$defs/obj_piston" },
        { "$ref": "#/$defs/obj_conveyor" },
        { "$ref": "#/$defs/obj_pulley" },
        { "$ref": "#/$defs/obj_fan" },
        { "$ref": "#/$defs/obj_magnet" },
        { "$ref": "#/$defs/obj_trigger" },
        { "$ref": "#/$defs/obj_goal" }
      ]
    },
    "obj_platform": {
      "type": "object",
      "allOf": [{ "$ref": "#/$defs/objBase" }],
      "properties": {
        "type": { "const": "platform" },
        "props": {
          "type": "object",
          "allOf": [{ "$ref": "#/$defs/staticSurfaceProps" }],
          "properties": {
            "w": { "type": "number", "minimum": 0.02, "maximum": 200 },
            "h": { "type": "number", "minimum": 0.02, "maximum": 200 }
          },
          "unevaluatedProperties": false
        }
      },
      "unevaluatedProperties": false
    },
    "obj_ramp": {
      "type": "object",
      "allOf": [{ "$ref": "#/$defs/objBase" }],
      "properties": {
        "type": { "const": "ramp" },
        "props": {
          "type": "object",
          "allOf": [{ "$ref": "#/$defs/staticSurfaceProps" }],
          "properties": {
            "w": { "type": "number", "minimum": 0.05, "maximum": 10 },
            "h": { "type": "number", "minimum": 0.05, "maximum": 10 },
            "flip": { "type": "boolean" }
          },
          "unevaluatedProperties": false
        }
      },
      "unevaluatedProperties": false
    },
    "obj_curve": {
      "type": "object",
      "allOf": [{ "$ref": "#/$defs/objBase" }],
      "properties": {
        "type": { "const": "curve" },
        "props": {
          "type": "object",
          "allOf": [{ "$ref": "#/$defs/staticSurfaceProps" }],
          "properties": {
            "r": { "type": "number", "minimum": 0.05, "maximum": 5 },
            "thickness": { "type": "number", "minimum": 0.01, "maximum": 0.2 },
            "sweep": { "type": "number", "minimum": 15, "maximum": 180 },
            "flip": { "type": "boolean" }
          },
          "unevaluatedProperties": false
        }
      },
      "unevaluatedProperties": false
    },
    "obj_domino": {
      "type": "object",
      "allOf": [{ "$ref": "#/$defs/objBase" }],
      "properties": {
        "type": { "const": "domino" },
        "props": {
          "type": "object",
          "allOf": [{ "$ref": "#/$defs/dynProps" }],
          "properties": {
            "h": { "type": "number", "minimum": 0.02, "maximum": 1 }
          },
          "unevaluatedProperties": false
        }
      },
      "unevaluatedProperties": false
    },
    "obj_marble": {
      "type": "object",
      "allOf": [{ "$ref": "#/$defs/objBase" }],
      "properties": {
        "type": { "const": "marble" },
        "props": {
          "type": "object",
          "allOf": [{ "$ref": "#/$defs/dynProps" }],
          "properties": {
            "r": { "type": "number", "minimum": 0.005, "maximum": 0.5 }
          },
          "unevaluatedProperties": false
        }
      },
      "unevaluatedProperties": false
    },
    "obj_crate": {
      "type": "object",
      "allOf": [{ "$ref": "#/$defs/objBase" }],
      "properties": {
        "type": { "const": "crate" },
        "props": {
          "type": "object",
          "allOf": [{ "$ref": "#/$defs/dynProps" }],
          "properties": {
            "w": { "type": "number", "minimum": 0.02, "maximum": 2 },
            "h": { "type": "number", "minimum": 0.02, "maximum": 2 }
          },
          "unevaluatedProperties": false
        }
      },
      "unevaluatedProperties": false
    },
    "obj_plank": {
      "type": "object",
      "allOf": [{ "$ref": "#/$defs/objBase" }],
      "properties": {
        "type": { "const": "plank" },
        "props": {
          "type": "object",
          "allOf": [{ "$ref": "#/$defs/dynProps" }],
          "properties": {
            "w": { "type": "number", "minimum": 0.05, "maximum": 4 },
            "h": { "type": "number", "minimum": 0.005, "maximum": 0.2 }
          },
          "unevaluatedProperties": false
        }
      },
      "unevaluatedProperties": false
    },
    "obj_gear": {
      "type": "object",
      "allOf": [{ "$ref": "#/$defs/objBase" }],
      "properties": {
        "type": { "const": "gear" },
        "props": {
          "type": "object",
          "allOf": [{ "$ref": "#/$defs/dynProps" }],
          "properties": {
            "r": { "type": "number", "minimum": 0.02, "maximum": 1 },
            "motorSpeed": { "type": "number", "minimum": -3600, "maximum": 3600 },
            "maxTorque": { "type": "number", "minimum": 0, "maximum": 100 }
          },
          "unevaluatedProperties": false
        }
      },
      "unevaluatedProperties": false
    },
    "obj_lever": {
      "type": "object",
      "allOf": [{ "$ref": "#/$defs/objBase" }],
      "properties": {
        "type": { "const": "lever" },
        "props": {
          "type": "object",
          "allOf": [{ "$ref": "#/$defs/dynProps" }],
          "properties": {
            "len": { "type": "number", "minimum": 0.05, "maximum": 4 },
            "h": { "type": "number", "minimum": 0.005, "maximum": 0.2 },
            "pivot": { "type": "number", "minimum": 0, "maximum": 1 },
            "minAngle": { "type": "number", "minimum": -360, "maximum": 360 },
            "maxAngle": { "type": "number", "minimum": -360, "maximum": 360 }
          },
          "unevaluatedProperties": false
        }
      },
      "unevaluatedProperties": false
    },
    "obj_spring": {
      "type": "object",
      "allOf": [{ "$ref": "#/$defs/objBase" }],
      "properties": {
        "type": { "const": "spring" },
        "props": {
          "type": "object",
          "allOf": [{ "$ref": "#/$defs/dynProps" }],
          "properties": {
            "w": { "type": "number", "minimum": 0.02, "maximum": 1 },
            "travel": { "type": "number", "minimum": 0.01, "maximum": 0.5 },
            "stiffness": { "type": "number", "minimum": 1, "maximum": 5000 },
            "damping": { "type": "number", "minimum": 0, "maximum": 100 },
            "mode": { "enum": ["passive", "triggered"] }
          },
          "unevaluatedProperties": false
        }
      },
      "unevaluatedProperties": false
    },
    "obj_pendulum": {
      "type": "object",
      "allOf": [{ "$ref": "#/$defs/objBase" }],
      "properties": {
        "type": { "const": "pendulum" },
        "props": {
          "type": "object",
          "allOf": [{ "$ref": "#/$defs/dynProps" }],
          "properties": {
            "len": { "type": "number", "minimum": 0.05, "maximum": 5 },
            "bobR": { "type": "number", "minimum": 0.01, "maximum": 0.5 },
            "arm": { "enum": ["rod", "rope"] }
          },
          "unevaluatedProperties": false
        }
      },
      "unevaluatedProperties": false
    },
    "obj_piston": {
      "type": "object",
      "allOf": [{ "$ref": "#/$defs/objBase" }],
      "properties": {
        "type": { "const": "piston" },
        "props": {
          "type": "object",
          "allOf": [{ "$ref": "#/$defs/dynProps" }],
          "properties": {
            "stroke": { "type": "number", "minimum": 0.02, "maximum": 2 },
            "w": { "type": "number", "minimum": 0.02, "maximum": 0.5 },
            "speed": { "type": "number", "minimum": 0.01, "maximum": 5 },
            "force": { "type": "number", "minimum": 0.1, "maximum": 500 },
            "mode": { "enum": ["cycle", "triggered"] },
            "period": { "type": "number", "minimum": 0.2, "maximum": 60 },
            "phase": { "type": "number", "minimum": 0, "maximum": 1 }
          },
          "unevaluatedProperties": false
        }
      },
      "unevaluatedProperties": false
    },
    "obj_conveyor": {
      "type": "object",
      "allOf": [{ "$ref": "#/$defs/objBase" }],
      "properties": {
        "type": { "const": "conveyor" },
        "props": {
          "type": "object",
          "allOf": [{ "$ref": "#/$defs/staticSurfaceProps" }],
          "properties": {
            "w": { "type": "number", "minimum": 0.05, "maximum": 10 },
            "h": { "type": "number", "minimum": 0.02, "maximum": 0.5 },
            "speed": { "type": "number", "minimum": -5, "maximum": 5 },
            "active": { "type": "boolean" }
          },
          "unevaluatedProperties": false
        }
      },
      "unevaluatedProperties": false
    },
    "obj_pulley": {
      "type": "object",
      "allOf": [{ "$ref": "#/$defs/objBase" }],
      "properties": {
        "type": { "const": "pulley" },
        "props": {
          "type": "object",
          "allOf": [{ "$ref": "#/$defs/staticSurfaceProps" }],
          "properties": {
            "r": { "type": "number", "minimum": 0.02, "maximum": 0.5 }
          },
          "unevaluatedProperties": false
        }
      },
      "unevaluatedProperties": false
    },
    "obj_fan": {
      "type": "object",
      "allOf": [{ "$ref": "#/$defs/objBase" }],
      "properties": {
        "type": { "const": "fan" },
        "props": {
          "type": "object",
          "properties": {
            "strength": { "type": "number", "minimum": 0.1, "maximum": 100 },
            "range": { "type": "number", "minimum": 0.05, "maximum": 10 },
            "spread": { "type": "number", "minimum": 5, "maximum": 90 },
            "active": { "type": "boolean" }
          },
          "additionalProperties": false
        }
      },
      "unevaluatedProperties": false
    },
    "obj_magnet": {
      "type": "object",
      "allOf": [{ "$ref": "#/$defs/objBase" }],
      "properties": {
        "type": { "const": "magnet" },
        "props": {
          "type": "object",
          "properties": {
            "strength": { "type": "number", "minimum": -100, "maximum": 100 },
            "range": { "type": "number", "minimum": 0.05, "maximum": 10 },
            "active": { "type": "boolean" }
          },
          "additionalProperties": false
        }
      },
      "unevaluatedProperties": false
    },
    "obj_trigger": {
      "type": "object",
      "allOf": [{ "$ref": "#/$defs/objBase" }],
      "properties": {
        "type": { "const": "trigger" },
        "props": {
          "type": "object",
          "properties": {
            "w": { "type": "number", "minimum": 0.02, "maximum": 5 },
            "h": { "type": "number", "minimum": 0.02, "maximum": 5 },
            "targets": {
              "type": "array",
              "maxItems": 32,
              "uniqueItems": true,
              "items": { "$ref": "#/$defs/id" }
            },
            "once": { "type": "boolean" }
          },
          "additionalProperties": false
        }
      },
      "unevaluatedProperties": false
    },
    "obj_goal": {
      "type": "object",
      "allOf": [{ "$ref": "#/$defs/objBase" }],
      "properties": {
        "type": { "const": "goal" },
        "props": {
          "type": "object",
          "properties": {
            "w": { "type": "number", "minimum": 0.02, "maximum": 5 },
            "h": { "type": "number", "minimum": 0.02, "maximum": 5 },
            "accepts": {
              "oneOf": [
                { "const": "any" },
                {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 32,
                  "uniqueItems": true,
                  "items": { "$ref": "#/$defs/id" }
                }
              ]
            }
          },
          "additionalProperties": false
        }
      },
      "unevaluatedProperties": false
    },
    "endpoint": {
      "type": "object",
      "required": ["obj"],
      "additionalProperties": false,
      "not": {
        "type": "object",
        "properties": { "anchor": true, "at": true },
        "required": ["anchor", "at"]
      },
      "properties": {
        "obj": { "$ref": "#/$defs/id" },
        "anchor": { "type": "string", "minLength": 1, "maxLength": 16 },
        "at": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": { "type": "number", "minimum": -100, "maximum": 100 }
        }
      }
    },
    "linkBase": {
      "type": "object",
      "required": ["id", "type", "a", "b"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "type": { "type": "string" },
        "a": { "$ref": "#/$defs/endpoint" },
        "b": { "$ref": "#/$defs/endpoint" }
      }
    },
    "link": {
      "oneOf": [
        { "$ref": "#/$defs/link_rope" },
        { "$ref": "#/$defs/link_springLink" },
        { "$ref": "#/$defs/link_weld" },
        { "$ref": "#/$defs/link_axle" },
        { "$ref": "#/$defs/link_gearMesh" }
      ]
    },
    "link_rope": {
      "type": "object",
      "allOf": [{ "$ref": "#/$defs/linkBase" }],
      "properties": {
        "type": { "const": "rope" },
        "props": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "length": { "type": "number", "minimum": 0.01, "maximum": 500 },
            "segments": {
              "oneOf": [
                { "const": 0 },
                { "type": "integer", "minimum": 2, "maximum": 64 }
              ]
            },
            "via": {
              "type": "array",
              "maxItems": 4,
              "uniqueItems": true,
              "items": { "$ref": "#/$defs/id" }
            }
          }
        }
      },
      "unevaluatedProperties": false
    },
    "link_springLink": {
      "type": "object",
      "allOf": [{ "$ref": "#/$defs/linkBase" }],
      "properties": {
        "type": { "const": "springLink" },
        "props": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "stiffness": { "type": "number", "minimum": 1, "maximum": 5000 },
            "damping": { "type": "number", "minimum": 0, "maximum": 100 },
            "restLength": { "type": "number", "minimum": 0.01, "maximum": 500 }
          }
        }
      },
      "unevaluatedProperties": false
    },
    "link_weld": {
      "type": "object",
      "allOf": [{ "$ref": "#/$defs/linkBase" }],
      "properties": {
        "type": { "const": "weld" },
        "props": {
          "type": "object",
          "additionalProperties": false,
          "properties": {}
        }
      },
      "unevaluatedProperties": false
    },
    "link_axle": {
      "type": "object",
      "allOf": [{ "$ref": "#/$defs/linkBase" }],
      "properties": {
        "type": { "const": "axle" },
        "props": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "motorSpeed": { "type": "number", "minimum": -3600, "maximum": 3600 },
            "maxTorque": { "type": "number", "minimum": 0, "maximum": 100 }
          }
        }
      },
      "unevaluatedProperties": false
    },
    "link_gearMesh": {
      "type": "object",
      "allOf": [{ "$ref": "#/$defs/linkBase" }],
      "properties": {
        "type": { "const": "gearMesh" },
        "props": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "ratio": {
              "type": "number",
              "minimum": -100,
              "maximum": 100,
              "not": { "const": 0 }
            }
          }
        }
      },
      "unevaluatedProperties": false
    }
  }
}
